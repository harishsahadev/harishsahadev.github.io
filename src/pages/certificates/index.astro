---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import CertCard from "../../components/CertCard.astro";
import CertificatesFilters from "../../components/certificates/CertificatesFilters.astro";
import CertificatesHeader from "../../components/certificates/CertificatesHeader.astro";
import Base from "../../layouts/Base.astro";
import { getCertificateTags, sortCertificates } from "../../utils/certificates";

let certificates: CollectionEntry<"certifications">[] = [];
let featuredTags: string[] = [];
let extraTags: string[] = [];

try {
  certificates = sortCertificates(await getCollection("certifications"));
  const tags = getCertificateTags(certificates);
  featuredTags = tags.featuredTags;
  extraTags = tags.extraTags;
} catch (error) {
  console.error("Error loading certifications:", error);
}
---

<Base title="Certificates" description="Certificates, workshops, and professional credentials.">
  <section class="certificates-page">
    <div class="container">
      <CertificatesHeader />

      <CertificatesFilters
        featuredTags={featuredTags}
        extraTags={extraTags}
        totalCertificates={certificates.length}
      />

      <div class="certs-grid">
        {certificates.map((certificate) => (
          <CertCard
            name={certificate.data.name}
            issuer={certificate.data.issuer}
            date={certificate.data.date}
            tags={certificate.data.tags}
            verifyUrl={certificate.data.verifyUrl}
            badge={certificate.data.badge}
            description={certificate.data.description}
            detailedDescription={certificate.data.detailedDescription}
            filterName={certificate.data.name.toLowerCase()}
            filterTags={(certificate.data.tags ?? []).join("|").toLowerCase()}
            filterIssuer={certificate.data.issuer.toLowerCase()}
          />
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .certificates-page {
    padding-block: var(--space-12) var(--space-24);
  }

  .certs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-6);
  }
</style>
