---
import Base from "../../layouts/Base.astro";
import CertCard from "../../components/CertCard.astro";
import { getCollection } from "astro:content";
import { compareContentDatesDesc } from "../../utils/contentDates";

const certificates = (await getCollection("certifications"))
  .sort((a, b) => {
    if (a.data.order != null && b.data.order != null) {
      return a.data.order - b.data.order;
    }

    if (a.data.order != null) return -1;
    if (b.data.order != null) return 1;

    return compareContentDatesDesc(a.data.date, b.data.date);
  });

const tagFrequency = new Map<string, number>();

for (const certificate of certificates) {
  for (const tag of certificate.data.tags ?? []) {
    tagFrequency.set(tag, (tagFrequency.get(tag) ?? 0) + 1);
  }
}

const sortedTags = Array.from(tagFrequency.entries())
  .sort((a, b) => {
    if (b[1] !== a[1]) return b[1] - a[1];
    return a[0].localeCompare(b[0]);
  })
  .map(([tag]) => tag);

const initialVisibleTags = 6;
const featuredTags = sortedTags.slice(0, initialVisibleTags);
const extraTags = sortedTags.slice(initialVisibleTags);
---

<Base title="Certificates" description="Certificates, workshops, and professional credentials.">
  <section class="certificates-page">
    <div class="container">
      <header class="certificates-header">
        <div class="section-label">Credentials</div>
        <h1 class="certificates-title">Certificates</h1>
        <p class="certificates-desc">
          The full list of certifications, workshop credentials, and validated learning milestones.
        </p>
      </header>

      <div class="certificates-controls" aria-label="Certificate filters">
        <div class="certificates-search-wrap">
          <div class="certificates-search-shell">
            <svg class="certificates-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
            </svg>
            <input
              id="certificate-search"
              class="certificates-search"
              type="search"
              placeholder="Search by certificate title"
              autocomplete="off"
              aria-label="Search certificates by title"
              data-cert-search
            />
          </div>
        </div>

        {sortedTags.length > 0 && (
          <div class="certificates-filter-group">
            <div class="certificates-filter-header">
              <p class="certificates-filter-label">Popular tags</p>
            </div>

            <div class="certificates-filter-row">
              <button
                type="button"
                class="certificates-filter-chip is-active"
                data-cert-filter="all"
                aria-pressed="true"
              >
                All
              </button>

              {featuredTags.map((tag) => (
                <button
                  type="button"
                  class="certificates-filter-chip"
                  data-cert-filter={tag}
                  aria-pressed="false"
                >
                  {tag}
                </button>
              ))}

              {extraTags.length > 0 && (
                <>
                  <div class="certificates-filter-extra" data-cert-extra-tags hidden>
                    {extraTags.map((tag) => (
                      <button
                        type="button"
                        class="certificates-filter-chip"
                        data-cert-filter={tag}
                        aria-pressed="false"
                      >
                        {tag}
                      </button>
                    ))}
                  </div>

                  <button
                    type="button"
                    class="certificates-filter-toggle"
                    data-cert-toggle
                    aria-expanded="false"
                  >
                    See more
                  </button>
                </>
              )}
            </div>
          </div>
        )}
      </div>

      <p class="certificates-results" data-cert-results>
        Showing {certificates.length} of {certificates.length} certificates
      </p>

      <div class="certs-grid">
        {certificates.map((certificate) => (
          <CertCard
            name={certificate.data.name}
            issuer={certificate.data.issuer}
            date={certificate.data.date}
            tags={certificate.data.tags}
            verifyUrl={certificate.data.verifyUrl}
            badge={certificate.data.badge}
            description={certificate.data.description}
            detailedDescription={certificate.data.detailedDescription}
            filterName={certificate.data.name.toLowerCase()}
            filterTags={(certificate.data.tags ?? []).join("|").toLowerCase()}
          />
        ))}
      </div>

      <p class="certificates-empty" data-cert-empty hidden>
        No certificates match the current search and tag filter.
      </p>
    </div>
  </section>
</Base>

<script is:inline>
  const searchInput = document.querySelector("[data-cert-search]");
  const resultLabel = document.querySelector("[data-cert-results]");
  const emptyState = document.querySelector("[data-cert-empty]");
  const certItems = Array.from(document.querySelectorAll("[data-cert-item]"));
  const filterButtons = Array.from(document.querySelectorAll("[data-cert-filter]"));
  const toggleButton = document.querySelector("[data-cert-toggle]");
  const extraTags = document.querySelector("[data-cert-extra-tags]");

  let activeTag = "all";

  const updateResults = () => {
    const query = searchInput instanceof HTMLInputElement ? searchInput.value.trim().toLowerCase() : "";
    let visibleCount = 0;

    for (const item of certItems) {
      if (!(item instanceof HTMLElement)) continue;

      const name = item.dataset.certName ?? "";
      const tags = (item.dataset.certTags ?? "").split("|").filter(Boolean);
      const matchesSearch = query === "" || name.includes(query);
      const matchesTag = activeTag === "all" || tags.includes(activeTag.toLowerCase());
      const isVisible = matchesSearch && matchesTag;

      item.hidden = !isVisible;
      if (isVisible) visibleCount += 1;
    }

    if (resultLabel instanceof HTMLElement) {
      resultLabel.textContent = `Showing ${visibleCount} of ${certItems.length} certificates`;
    }

    if (emptyState instanceof HTMLElement) {
      emptyState.hidden = visibleCount !== 0;
    }
  };

  for (const button of filterButtons) {
    button.addEventListener("click", () => {
      activeTag = button.getAttribute("data-cert-filter") ?? "all";

      for (const candidate of filterButtons) {
        const isActive = candidate === button;
        candidate.classList.toggle("is-active", isActive);
        candidate.setAttribute("aria-pressed", String(isActive));
      }

      updateResults();
    });
  }

  if (searchInput instanceof HTMLInputElement) {
    searchInput.addEventListener("input", updateResults);
  }

  if (toggleButton instanceof HTMLButtonElement && extraTags instanceof HTMLElement) {
    toggleButton.addEventListener("click", () => {
      const isExpanded = toggleButton.getAttribute("aria-expanded") === "true";
      const nextExpanded = !isExpanded;

      toggleButton.setAttribute("aria-expanded", String(nextExpanded));
      toggleButton.textContent = nextExpanded ? "Close tags" : "See more";
      extraTags.hidden = !nextExpanded;
    });
  }
</script>

<style>
  .certificates-page {
    padding-block: var(--space-12) var(--space-24);
  }

  .certificates-header {
    max-width: 44rem;
    margin-bottom: var(--space-12);
  }

  .section-label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: var(--space-4);
  }

  .certificates-title {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.05;
    margin-bottom: var(--space-3);
  }

  .certificates-desc {
    font-size: 1.0625rem;
    color: var(--text-muted);
    line-height: 1.75;
  }

  .certificates-controls {
    display: grid;
    gap: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .certificates-search-wrap {
    display: grid;
    gap: var(--space-3);
    max-width: 36rem;
  }

  .certificates-filter-label,
  .certificates-results {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .certificates-filter-label {
    color: var(--text-faint);
  }

  .certificates-search-shell {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0.65rem 0.95rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition: border-color var(--duration) var(--ease-out),
                box-shadow var(--duration) var(--ease-out),
                background-color var(--duration) var(--ease-out);
  }

  .certificates-search-shell:focus-within {
    border-color: color-mix(in srgb, var(--accent) 70%, transparent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .certificates-search-icon {
    flex-shrink: 0;
    color: var(--text-faint);
  }

  .certificates-search {
    width: 100%;
    border: 0;
    background: transparent;
    color: var(--text);
    padding: 0;
    font: inherit;
    font-size: 0.98rem;
  }

  .certificates-search:focus {
    outline: none;
  }

  .certificates-search::placeholder {
    color: var(--text-faint);
  }

  .certificates-filter-group {
    display: grid;
    gap: var(--space-4);
  }

  .certificates-filter-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .certificates-filter-label {
    margin: 0;
  }

  .certificates-filter-row,
  .certificates-filter-extra {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
  }

  .certificates-filter-extra[hidden] {
    display: none;
  }

  .certificates-filter-chip,
  .certificates-filter-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-raised);
    color: var(--text-muted);
    padding: 0.42rem 0.82rem;
    font: inherit;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
    transition: border-color var(--duration) var(--ease-out),
                background-color var(--duration) var(--ease-out),
                color var(--duration) var(--ease-out),
                transform 220ms var(--ease-out);
  }

  .certificates-filter-chip:hover,
  .certificates-filter-toggle:hover {
    transform: translateY(-1px);
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-muted);
  }

  .certificates-filter-chip.is-active {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-muted);
  }

  .certificates-filter-toggle {
    color: var(--accent);
    background: transparent;
    border-style: dashed;
  }

  .certificates-results {
    color: var(--text-faint);
    margin-bottom: var(--space-6);
  }

  .certs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-6);
  }

  .certificates-empty {
    margin-top: var(--space-8);
    color: var(--text-muted);
    text-align: center;
    padding: var(--space-6);
    border: 1px dashed var(--border);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--bg-card) 94%, transparent);
  }

  @media (max-width: 640px) {
    .certificates-controls {
      gap: var(--space-5);
    }

    .certificates-search-shell {
      padding: 0.68rem 0.9rem;
    }
    .certificates-filter-row,

    .certificates-filter-extra {
      gap: 0.6rem;
    }
  }
</style>
