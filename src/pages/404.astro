---
import Base from "../layouts/Base.astro";
---

<Base title="Page Not Found" description="The page you're looking for doesn't exist.">
  <div class="error-container">
    <section class="error-content">
      <div class="error-code">404</div>
      <h1 class="error-title">Page Not Found</h1>
      <p class="error-description">
        Looks like something went wrong. The page you're looking for doesn't exist or has been moved.
      </p>
      <div class="error-actions">
        <a href="/" class="error-button">Back to Home</a>
        <a href="/blog" class="error-button secondary">Read Blog</a>
      </div>
    </section>
  </div>
</Base>

<style>
  .error-container {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 200px);
    padding: var(--space-8);
  }

  .error-content {
    max-width: 500px;
    text-align: center;
  }

  .error-code {
    font-family: var(--font-mono);
    font-size: clamp(4rem, 15vw, 8rem);
    font-weight: 700;
    color: var(--accent);
    margin-bottom: var(--space-4);
    line-height: 1;
  }

  .error-title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    line-height: 1.2;
    color: var(--text);
    margin-bottom: var(--space-4);
  }

  .error-description {
    font-size: 1.0625rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-8);
  }

  .error-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .error-button {
    display: inline-block;
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
    transition: all var(--duration) var(--ease-out);
    cursor: pointer;
  }

  .error-button:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-2px);
  }

  .error-button.secondary {
    background: var(--bg-card);
  }

  .error-button.secondary:hover {
    background: color-mix(in srgb, var(--bg-card) 150%, var(--accent));
  }

  @media (min-width: 640px) {
    .error-actions {
      flex-direction: row;
      justify-content: center;
    }

    .error-button {
      flex: 1;
      max-width: 200px;
    }
  }
</style>
